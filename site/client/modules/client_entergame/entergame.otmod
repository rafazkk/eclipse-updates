Module
  name: client_entergame
  description: Manages enter game and character list windows
  author: edubart

  dependencies:
    - game_features
    - game_things

  scripts: [ eclipse_config, eclipse, eclipse_characters, entergame, characterlist, createAccount ]

  @onLoad: |
    EnterGame.init()
    CharacterList.init()

  @onUnload: |
    EnterGame.terminate()
    CharacterList.terminate()
