EclipseCharacterButton < UIButton
  image-source: /images/eclipse-login/button-secondary
  image-border: 8
  image-border-left: 24
  image-border-right: 24
  ttf-font: /fonts/ttf/Cinzel-Regular.ttf
  ttf-font-size: 12
  color: #e6d4ec
  text-align: center
  cursor: pointer
  $hover:
    image-color: #ebc9ffff
    color: #ffffff
  $pressed:
    image-color: #ab83cbff

CharacterWidget < UIWidget
  height: 20
  &updateOnStates: |
    function(self)
      local children = self:getChildren()
      for i=1,#children do
        children[i]:setOn(self:isFocused())
      end
      local parent = self:getParent()
      for i, children in ipairs(parent:getChildren()) do
        if i % 2 == 1 and not children:isFocused() then
          children:setBackgroundColor("#21122bdc")
        elseif children:isFocused() then
          children:setBackgroundColor("#784496cc")
        else
          children:setBackgroundColor("#100b18d8")
        end
      end
    end
  @onFocusChange: self:updateOnStates()
  @onSetup: |
    self:updateOnStates()
    if g_game.getFeature(GameEnterGameShowAppearance) then
      self:setHeight(66)
    end

  UIWidget
    id: outfit
    size: 70 70
    &baseWidth: 70
    anchors.top: parent.top
    anchors.left: parent.left

    UICreature
      id: outfitCreatureBox
      size: 64 64
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      creatureDisplay:setCreature(creature)
      margin-left: -2
      margin-top: -1
      fixed-creature-size: true
      @onSetup: |
        if not(g_game.getFeature(GameEnterGameShowAppearance)) then
          self:hide()
        end

  Label
    id: name
    anchors.top: parent.top
    anchors.left: prev.right
    color: #ebdbee
    ttf-font: /fonts/ttf/verdana-bold.ttf
    ttf-font-size: 12
    text-auto-resize: true
    background-color: alpha
    margin-left: -2

    $on:
      color: #ffffff

  Label
    id: mainCharacter
    size: 9 8
    anchors.top: parent.top
    anchors.left: prev.right
    margin-left: 3
    margin-top: 4
    image-source: /images/game/entergame/maincharacter
    image-clip: 0 0 9 8

  UIWidget
    id: characterPin
    size: 12 12
    image-source: /images/ui/fix-button
    image-size: 12 12
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 264
    margin-top: 2
    visible: false
    focusable: false
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: statusDailyReward
    size: 11 19
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 281
    margin-top: 2
    image-source: /images/game/entergame/dailyreward_collected
    image-clip: 0 0 11 19
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: statusHidden
    size: 11 19
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 281
    margin-top: 2
    image-source: /images/game/entergame/hidden
    image-clip: 0 0 11 19
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: level
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 335
    color: #d7c5e1
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 11
    text-auto-resize: true
    background-color: alpha
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

    $on:
      color: #ffffff

  Label
    id: vocation
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 385
    color: #d7c5e1
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 11
    text-auto-resize: true
    background-color: alpha
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

    $on:
      color: #ffffff

  Label
    id: worldName
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 500
    color: #e1c993
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 11
    text-auto-resize: true
    background-color: alpha
    &baseText: '(%s)'
    @onSetup: |
      self:addAnchor(AnchorLeft, 'parent', AnchorLeft)
      self:setMarginLeft(500)
      self.baseText = '%s'

    $on:
      color: #ffffff

  Label
    id: worldPvpType
    anchors.top: prev.bottom
    color: #ba9ec6
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 10
    text-auto-resize: true
    background-color: alpha
    &baseText: '(%s)'
    @onSetup: |
      self:addAnchor(AnchorLeft, 'parent', AnchorLeft)
      self:setMarginTop(-1)
      self:setMarginLeft(500)
      self.baseText = '%s'

    $on:
      color: #ffffff

UIWindow
  id: charactersWindow
  visible: false
  anchors.centerIn: parent
  size: 785 525
  draggable: false
  image-source: /images/eclipse-login/panel
  image-border: 24
  padding-left: 26
  padding-right: 26
  padding-top: 72
  padding-bottom: 32
  @onEnter: CharacterList.doLogin()
  @onEscape: CharacterList.hide(true)
  @onSetup: |
    g_keyboard.bindKeyPress('Up', function()
      local list = self:recursiveGetChildById('characters')
      if not list then return end
      list:focusPreviousChild(KeyboardFocusReason)
      local focused = list:getFocusedChild()
      if focused then list:ensureChildVisible(focused) end
    end, self)
    g_keyboard.bindKeyPress('Down', function()
      local list = self:recursiveGetChildById('characters')
      if not list then return end
      list:focusNextChild(KeyboardFocusReason)
      local focused = list:getFocusedChild()
      if focused then list:ensureChildVisible(focused) end
    end, self)
    if g_game.getFeature(GamePreviewState) then
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setSize({width = 785, height = 525})
      else
        self:setSize({width = 470, height = 450})
      end
    else
      self:setSize({width = 470, height = 450})
    end

  UIWidget
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -42
    size: 36 35
    image-source: /images/eclipse-login/news-welcome
    phantom: true

  UILabel
    text: ESCOLHA SEU PERSONAGEM
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -12
    size: 370 26
    text-align: center
    ttf-font: /fonts/ttf/Cinzel-Regular.ttf
    ttf-font-size: 19
    color: #e9d3a4
    phantom: true

  Label
    id: recoverySetupLabel
    anchors.left: parent.left
    anchors.top: parent.top
    height: 0
    margin-top: 3
    text-align: left
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 11
    color: #FF9854
    visible: false

  UIWidget
    id: charactersListFrame
    background-color: #0d0919e8
    border-width: 1
    border-color: #87569d
    @onSetup: |
      self:breakAnchors()
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setSize({ width = 713, height = 263 })
        self:addAnchor(AnchorTop, 'recoverySetupLabel', AnchorBottom)
        self:addAnchor(AnchorLeft, 'parent', AnchorLeft)
        self:setMarginTop(8)
        self:setMarginLeft(1)
        self:setMarginBottom(0)
      else
        self:addAnchor(AnchorTop, 'recoverySetupLabel', AnchorBottom)
        self:addAnchor(AnchorLeft, 'parent', AnchorLeft)
        self:addAnchor(AnchorRight, 'characterListScrollBar', AnchorLeft)
        self:addAnchor(AnchorBottom, 'accountStatusCaption', AnchorTop)
        self:setMarginTop(8)
        self:setMarginLeft(1)
        self:setMarginBottom(5)
      end

    UIWidget
      id: charactersListInner
      anchors.fill: parent
      margin: 1
      background-color: #0c0817e8
      @onSetup: |
        if not g_game.getFeature(GameEnterGameShowAppearance) then
          local header = self:getChildById('charactersTableHeader')
          local sep = self:getChildById('charactersHeaderSeparator')
          local list = self:getChildById('characters')
          if header then
            header:setVisible(false)
            header:setHeight(0)
          end
          if sep then
            sep:setVisible(false)
            sep:setHeight(0)
          end
          if list then
            list:breakAnchors()
            list:addAnchor(AnchorTop, 'parent', AnchorTop)
            list:addAnchor(AnchorLeft, 'parent', AnchorLeft)
            list:addAnchor(AnchorRight, 'parent', AnchorRight)
            list:addAnchor(AnchorBottom, 'parent', AnchorBottom)
          end
        end

      UIWidget
        id: charactersTableHeader
        height: 24
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        background-color: #281632

        Label
          margin-left: 68
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          text: PERSONAGEM
          ttf-font: /fonts/ttf/verdana-bold.ttf
          ttf-font-size: 10
          color: #e7d19f
          text-align: center
          text-offset: 0 0

        Label
          margin-left: 281
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          text: STATUS
          ttf-font: /fonts/ttf/verdana-bold.ttf
          ttf-font-size: 10
          color: #e7d19f
          text-align: center

        Label
          margin-left: 336
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          text: NÍVEL
          @onSetup: self:setText(EclipseLogin.toClientText(self:getText()))
          ttf-font: /fonts/ttf/verdana-bold.ttf
          ttf-font-size: 10
          color: #e7d19f
          text-align: center

        Label
          id: vocationHeader
          margin-left: 386
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          text: VOCAÇÃO
          @onSetup: self:setText(EclipseLogin.toClientText(self:getText()))
          ttf-font: /fonts/ttf/verdana-bold.ttf
          ttf-font-size: 10
          color: #e7d19f
          text-align: center

        Label
          margin-left: 501
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          text: MUNDO
          ttf-font: /fonts/ttf/verdana-bold.ttf
          ttf-font-size: 10
          color: #e7d19f
          text-align: center

        // A-Z sorting / server order (disabled for now)
        //Button
        //  id: sortOrderButton
        //  anchors.right: parent.right
        //  anchors.verticalCenter: parent.verticalCenter
        //  margin-right: 2
        //  size: 30 14
        //  text: 'Srv'
        //  text-offset: 0 -1
        //  font: $var-cip-font
        //  tooltip: tr('Sorted by server order')

      TextList
        id: characters
        anchors.top: charactersHeaderSeparator.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        border-width: 0
        padding: 0
        focusable: false
        auto-focus: first
        @onSetup: |
          if g_game.getFeature(GameEnterGameShowAppearance) then
            self:setBackgroundColor("#0c0817e8")
          else
            self:setBackgroundColor("#0c0817e8")
          end

      VerticalSeparator
        image-color: #805898
        anchors.left: parent.left
        anchors.top: charactersTableHeader.top
        anchors.bottom: characters.bottom
        margin-left: 277
        @onSetup: |
          if not(g_game.getFeature(GameEnterGameShowAppearance)) then
            self:hide()
          end

      VerticalSeparator
        image-color: #805898
        anchors.left: parent.left
        anchors.top: charactersTableHeader.top
        anchors.bottom: characters.bottom
        margin-left: 332
        @onSetup: |
          if not(g_game.getFeature(GameEnterGameShowAppearance)) then
            self:hide()
          end

      VerticalSeparator
        image-color: #805898
        anchors.left: parent.left
        anchors.top: charactersTableHeader.top
        anchors.bottom: characters.bottom
        margin-left: 382
        @onSetup: |
          if not(g_game.getFeature(GameEnterGameShowAppearance)) then
            self:hide()
          end

      VerticalSeparator
        image-color: #805898
        anchors.left: parent.left
        anchors.top: charactersTableHeader.top
        anchors.bottom: characters.bottom
        margin-left: 497
        @onSetup: |
          if not(g_game.getFeature(GameEnterGameShowAppearance)) then
            self:hide()
          end

      HorizontalSeparator
        id: charactersHeaderSeparator
        image-color: #805898
        anchors.top: charactersTableHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-left: 0
        margin-right: 0
        z-index: 2

  VerticalQtScrollBar
    id: characterListScrollBar
    anchors.top: charactersListFrame.top
    anchors.bottom: charactersListFrame.bottom
    anchors.right: parent.right
    margin-bottom: 1
    margin-top: 1
    margin-right: 1
    step: 20
    pixels-scroll: true
    parent-scroll: false

  UIButton
    id: getPremiumButton
    anchors.right: parent.right
    anchors.bottom: separator.top
    margin-bottom: 12
    image-border: 8
    image-border-left: 24
    image-border-right: 24
    cursor: pointer
    image-source: /images/eclipse-login/button-secondary
    size: 110 27
    text: "PREMIUM"
    text-offset: 0 1
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 10
    visible: false
    @onClick: EclipseLogin.openLink('premium')

    $pressed:
      image-color: #ab83cbff
      text-offset: 1 2

  Label
    id: accountStatusCaption
    text: STATUS DA CONTA:
    anchors.left: parent.left
    anchors.bottom: next.top
    color: #d9c8df
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 11
    @onSetup: |
      self:setMarginBottom(6)

  Label
    id: accountStatusIcon
    size: 22 20
    anchors.left: parent.left
    anchors.bottom: next.bottom
    margin-bottom: 1
    margin-left: 1
    image-source: /images/game/entergame/premium
    image-clip: 0 0 22 20

  Label
    id: accountStatusLabel
    !text: tr('Free Account')
    anchors.left: parent.left
    text-auto-resize: true
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 11
    color: #e5d2b2
    @onSetup: |
      self:setMarginBottom(10)
      self:setPaddingBottom(4)
      self:setTextOffset({x = 27, y = 0})
      self:addAnchor(AnchorBottom, 'next', AnchorBottom)

  HorizontalSeparator
    id: separator
    image-color: #805898
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 1
    anchors.bottom: next.top
    margin-bottom: 11

  UIWidget
    id: characterBoxBackground
    size: 184 22
    background-color: #1a1127
    border-width: 1
    border-color: #6e4b83
    margin-left: 1
    margin-bottom: 45
    anchors.left: parent.left
    anchors.bottom: parent.bottom

  QtCheckBox
    id: hiddenCharacterBox
    text: Mostrar ocultos
    anchors.verticalCenter: characterBoxBackground.verticalCenter
    anchors.horizontalCenter: characterBoxBackground.horizontalCenter
    margin-left: 2
    margin-top: -1
    text-offset: 16 0
    width: 180
    color: #d9c8df
    image-color: #ba92dd
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 10
    @onCheckChange: modules.client_entergame.toggleHiddenCharacters(self:isChecked())

  UIWidget
    id: outfitBoxBackground
    size: 107 22
    background-color: #1a1127
    border-width: 1
    border-color: #6e4b83
    margin-left: 11
    margin-bottom: 45
    anchors.left: characterBoxBackground.right
    anchors.bottom: parent.bottom

  QtCheckBox
    id: showOutfitBox
    text: Mostrar outfits
    anchors.verticalCenter: outfitBoxBackground.verticalCenter
    anchors.horizontalCenter: outfitBoxBackground.horizontalCenter
    width: 100
    margin-top: -1
    text-offset: 16 0
    color: #d9c8df
    image-color: #ba92dd
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 10
    checked: true
    @onCheckChange: modules.client_entergame.toggleShowOutfit(self:isChecked())

  EclipseCharacterButton
    id: buttonOk
    text: ENTRAR
    size: 100 30
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-bottom: 1
    margin-right: 11
    text-offset: 0 0
    @onClick: CharacterList.doLogin()

  EclipseCharacterButton
    id: buttonCancel
    text: VOLTAR
    size: 100 30
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 1
    text-offset: 0 0
    @onClick: CharacterList.hide(true)
