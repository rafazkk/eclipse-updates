EclipseCharacterButton < UIButton
  image-source: /images/eclipse-login/button-secondary
  image-repeated: false
  image-smooth: true
  ttf-font: /fonts/ttf/Cinzel-Regular.ttf
  ttf-font-size: 12
  color: #e7d7b4
  text-align: center
  cursor: pointer
  $hover:
    image-color: #ebc9ffff
    color: #fff1d0
  $pressed:
    image-color: #ab83cbff
  $on:
    image-color: #ce9deaff
    color: #fff1d0

EclipseCharacterText < UILabel
  ttf-font: /fonts/ttf/Verdana.ttf
  ttf-font-size: 11
  color: #ddcfe5
  phantom: true

CharacterWidget < UIWidget
  size: 296 360
  margin-right: 12
  border-width: 1
  border-color: #6b4d83
  background-color: #100d1855
  focusable: true
  cursor: pointer
  $focus:
    border-color: #dbc08e
    background-color: #402b5066
  $hover !focus:
    border-color: #ae7ccd

  UIWidget
    id: heroArt
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-bottom: 8
    size: 152 228
    image-repeated: false
    image-smooth: true
    phantom: true

  UIWidget
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 120
    background-color: #100b17d9
    phantom: true

  EclipseCharacterText
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin: 10 26 0 12
    height: 34
    ttf-font: /fonts/ttf/verdana-bold.ttf
    ttf-font-size: 14
    color: #f1e0b9
    text-wrap: true

  EclipseCharacterText
    id: level
    anchors.top: name.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 12
    margin-top: 4
    height: 14
    &baseText: 'Nível: %s'

  EclipseCharacterText
    id: vocation
    anchors.top: level.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 12
    height: 14
    &baseText: 'Vocação: %s'

  EclipseCharacterText
    id: worldName
    anchors.top: vocation.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 12
    height: 14
    &baseText: 'Mundo: %s'

  EclipseCharacterText
    id: worldPvpType
    anchors.top: worldName.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 12
    height: 14
    color: #bfa8cf

  EclipseCharacterText
    id: presentationBadge
    anchors.top: worldPvpType.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 12
    height: 14
    ttf-font-size: 10

  UIWidget
    id: outfit
    size: 56 56
    &baseWidth: 56
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 8
    margin-bottom: 8
    background-color: #160d23c9
    border-width: 1
    border-color: #9873aa
    phantom: true

    UICreature
      id: outfitCreatureBox
      size: 54 54
      anchors.centerIn: parent
      fixed-creature-size: true
      phantom: true

  UIWidget
    id: mainCharacter
    size: 9 8
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 10 10 0 0
    image-clip: 0 0 9 8
    phantom: true

  UIWidget
    id: characterPin
    size: 12 12
    image-source: /images/ui/fix-button
    anchors.top: mainCharacter.bottom
    anchors.right: parent.right
    margin-right: 8
    margin-top: 8
    visible: false
    focusable: false
    cursor: pointer

  UIWidget
    id: statusDailyReward
    size: 11 19
    anchors.top: characterPin.bottom
    anchors.right: parent.right
    margin-right: 8
    margin-top: 8
    image-clip: 0 0 11 19
    phantom: true

  UIWidget
    id: statusHidden
    size: 11 19
    anchors.top: statusDailyReward.bottom
    anchors.right: parent.right
    margin-right: 8
    margin-top: 8
    image-clip: 0 0 11 19
    phantom: true

UIWindow
  id: charactersWindow
  visible: false
  anchors.centerIn: parent
  size: 1000 660
  draggable: false
  image-source: /images/eclipse-selection/background
  image-repeated: false
  image-smooth: true
  @onEnter: CharacterList.doLogin()
  @onEscape: CharacterList.hide(true)
  @onGeometryChange: CharacterList.resize()
  @onSetup: |
    for _, key in ipairs({'Left', 'Up'}) do
      g_keyboard.bindKeyPress(key, function() CharacterList.moveSelection(-1) end, self)
    end
    for _, key in ipairs({'Right', 'Down'}) do
      g_keyboard.bindKeyPress(key, function() CharacterList.moveSelection(1) end, self)
    end

  UILabel
    text: ESCOLHA SEU PERSONAGEM
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 84
    size: 680 28
    text-align: center
    ttf-font: /fonts/ttf/Cinzel-Regular.ttf
    ttf-font-size: 23
    color: #ead8b2
    phantom: true

  EclipseCharacterText
    text: BEM-VINDO AO MUNDO ECLIPSE
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    size: 430 18
    text-align: center
    color: #d5c6a6

  EclipseCharacterButton
    id: charactersTab
    text: PERSONAGENS
    anchors.top: parent.top
    anchors.left: parent.left
    margin: 24 0 0 32
    size: 142 32
    @onClick: CharacterList.selectTab('characters')

  EclipseCharacterButton
    id: loreTab
    text: VOCAÇÕES
    @onSetup: self:setText(EclipseLogin.toClientText(self:getText()))
    anchors.top: charactersTab.bottom
    anchors.left: charactersTab.left
    margin-top: 4
    size: 142 32
    @onClick: CharacterList.selectTab('lore')

  EclipseCharacterText
    id: recoverySetupLabel
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 128
    size: 650 18
    text-align: center
    color: #ffb270
    visible: false

  UIWidget
    id: charactersListFrame
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 155 32 145 32

    HorizontalList
      id: characters
      anchors.fill: parent
      padding: 1
      border-width: 0
      background-color: alpha
      focusable: false
      auto-focus: first

  HorizontalQtScrollBar
    id: characterListScrollBar
    anchors.left: charactersListFrame.left
    anchors.right: charactersListFrame.right
    anchors.top: charactersListFrame.bottom
    margin-top: 4
    height: 12
    step: 308
    pixels-scroll: true
    parent-scroll: false

  UIWidget
    id: lorePanel
    visible: false
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 155 32 126 32
    background-color: #110a1bef
    border-width: 1
    border-color: #8f699e

    EclipseCharacterButton
      id: guardianButton
      text: GUARDIAN
      anchors.top: parent.top
      anchors.left: parent.left
      margin: 10 0 0 18
      size: 174 30
      @onClick: CharacterList.selectLoreClass('guardian')

    EclipseCharacterButton
      id: slayerButton
      text: SLAYER
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 6
      size: 174 30
      @onClick: CharacterList.selectLoreClass('slayer')

    EclipseCharacterButton
      id: arcanistButton
      text: ARCANIST
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 6
      size: 174 30
      @onClick: CharacterList.selectLoreClass('arcanist')

    EclipseCharacterButton
      id: mysticButton
      text: MYSTIC
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 6
      size: 174 30
      @onClick: CharacterList.selectLoreClass('mystic')

    EclipseCharacterButton
      id: rangerButton
      text: RANGER
      anchors.top: prev.top
      anchors.left: prev.right
      margin-left: 6
      size: 174 30
      @onClick: CharacterList.selectLoreClass('ranger')

    UIWidget
      id: loreArt
      anchors.top: guardianButton.bottom
      anchors.left: parent.left
      margin: 12 0 12 24
      size: 120 318
      image-repeated: false
      image-smooth: true
      phantom: true

    EclipseCharacterText
      id: loreName
      anchors.top: loreArt.top
      anchors.left: loreArt.right
      anchors.right: parent.right
      margin: 4 24 0 26
      height: 32
      ttf-font: /fonts/ttf/Cinzel-Regular.ttf
      ttf-font-size: 26

    EclipseCharacterText
      id: loreRole
      anchors.top: loreName.bottom
      anchors.left: loreName.left
      anchors.right: loreName.right
      height: 22
      color: #dec38f
      ttf-font-size: 13

    EclipseCharacterText
      id: loreQuote
      anchors.top: loreRole.bottom
      anchors.left: loreName.left
      anchors.right: loreName.right
      margin-top: 6
      height: 32
      text-wrap: true
      color: #bdadce

    EclipseCharacterText
      id: loreDescription
      anchors.top: loreQuote.bottom
      anchors.left: loreName.left
      anchors.right: loreName.right
      margin-top: 6
      height: 92
      text-wrap: true
      text-align: topLeft
      ttf-font-size: 12

    EclipseCharacterText
      text: PRINCIPAIS ATRIBUTOS
      anchors.top: loreDescription.bottom
      anchors.left: loreName.left
      height: 22
      color: #dec38f

    EclipseCharacterText
      id: loreAttributes
      anchors.top: prev.bottom
      anchors.left: loreName.left
      anchors.right: loreName.right
      height: 24

    EclipseCharacterText
      text: ESPECIALIZAÇÕES
      @onSetup: self:setText(EclipseLogin.toClientText(self:getText()))
      anchors.top: loreAttributes.bottom
      anchors.left: loreName.left
      height: 22
      color: #dec38f

    EclipseCharacterText
      id: loreSpecializations
      anchors.top: prev.bottom
      anchors.left: loreName.left
      anchors.right: loreName.right
      height: 24

  EclipseCharacterText
    id: accountStatusCaption
    text: STATUS DA CONTA
    anchors.bottom: accountStatusLabel.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 3
    size: 240 18
    text-align: center
    color: #ddc393

  EclipseCharacterText
    id: accountStatusLabel
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 83
    size: 410 18
    text-align: center

  UIWidget
    id: accountStatusIcon
    anchors.right: accountStatusLabel.left
    anchors.verticalCenter: accountStatusLabel.verticalCenter
    size: 22 20
    image-clip: 0 0 22 20
    phantom: true

  EclipseCharacterButton
    id: getPremiumButton
    anchors.right: parent.right
    anchors.verticalCenter: accountStatusLabel.verticalCenter
    margin-right: 35
    size: 110 28
    image-source: /images/eclipse-login/button-secondary
    image-repeated: false
    visible: false
    text: PREMIUM
    @onClick: EclipseLogin.openLink('premium')

  UIWidget
    id: characterBoxBackground
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 34
    margin-bottom: 55
    size: 242 22
    background-color: #120d20bf

  QtCheckBox
    id: hiddenCharacterBox
    text: Exibir personagens ocultos
    anchors.fill: characterBoxBackground
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 11
    color: #d9c8df
    text-offset: 18 0
    @onCheckChange: modules.client_entergame.toggleHiddenCharacters(self:isChecked())

  UIWidget
    id: outfitBoxBackground
    anchors.left: characterBoxBackground.left
    anchors.top: characterBoxBackground.bottom
    margin-top: 4
    size: 242 22
    background-color: #120d20bf

  QtCheckBox
    id: showOutfitBox
    text: Visualizar outfits
    anchors.fill: outfitBoxBackground
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 11
    color: #d9c8df
    text-offset: 18 0
    checked: true
    @onCheckChange: modules.client_entergame.toggleShowOutfit(self:isChecked())

  EclipseCharacterButton
    id: buttonOk
    text: ENTRAR
    image-source: /images/eclipse-login/button-primary
    anchors.right: buttonCancel.left
    anchors.bottom: parent.bottom
    margin-right: 12
    margin-bottom: 33
    size: 140 36
    @onClick: CharacterList.doLogin()

  EclipseCharacterButton
    id: buttonCancel
    text: VOLTAR
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 34
    margin-bottom: 33
    size: 140 36
    @onClick: CharacterList.hide(true)
