EclipseLabel < UILabel
  ttf-font: /fonts/ttf/Verdana.ttf
  ttf-font-size: 12
  color: #d5cde1
  phantom: true
  focusable: false

EclipsePanel < UIWidget
  image-source: /images/eclipse-login/panel
  image-border: 24
  image-smooth: true
  focusable: false

EclipseButton < UIButton
  height: 36
  ttf-font: /fonts/ttf/verdana-bold.ttf
  ttf-font-size: 12
  color: #e7d7b4
  image-source: /images/eclipse-login/button-secondary
  image-repeated: false
  image-smooth: true
  text-offset: 0 0
  padding: 0
  cursor: pointer
  $hover !disabled:
    color: #f1e6d0
    image-color: #dcc3ff
  $pressed:
    text-offset: 0 1
    image-color: #a18bb5
  $disabled:
    opacity: 0.5

EclipseNavButton < EclipseButton
  text-offset: 12 0
  ttf-font: /fonts/ttf/Verdana.ttf
  ttf-font-size: 11
  UIWidget
    id: actionIcon
    size: 23 23
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 12
    image-smooth: true
    phantom: true

EclipseInput < UITextEdit
  height: 31
  ttf-font: /fonts/ttf/Verdana.ttf
  ttf-font-size: 12
  color: #ede7f4
  background-color: #090512ed
  border-width: 1
  border-color: #673198
  padding-left: 29
  padding-right: 7
  padding-top: 4
  selection-color: #ffffffff
  selection-background-color: #642da0
  placeholder-color: #9688ad
  $focus:
    border-color: #b27bf0

EclipseCheckBox < CheckBox
  ttf-font: /fonts/ttf/Verdana.ttf
  ttf-font-size: 10
  color: #b9afc8
  image-color: #c196f4
  height: 16
  text-offset: 18 0

EclipseNewsItem < UIWidget
  height: 64
  focusable: false
  UIWidget
    id: newsIcon
    size: 33 33
    anchors.left: parent.left
    anchors.top: parent.top
    image-smooth: true
    phantom: true
  EclipseLabel
    id: newsTitle
    anchors.left: newsIcon.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 10
    height: 20
    text-wrap: true
    ttf-font: /fonts/ttf/verdana-bold.ttf
    ttf-font-size: 11
    color: #d4b86e
  EclipseLabel
    id: newsDate
    anchors.left: newsTitle.left
    anchors.right: parent.right
    anchors.top: newsTitle.bottom
    height: 10
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 9
    color: #9b86b1
  EclipseLabel
    id: newsDescription
    anchors.left: newsTitle.left
    anchors.right: parent.right
    anchors.top: newsDate.bottom
    height: 34
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 10
    text-align: topLeft
    text-wrap: true

UIWindow
  id: enterGame
  anchors.fill: parent
  focusable: true
  draggable: false
  @onEnter: EnterGame.doLogin()

  EclipseLabel
    id: adventureTagline
    text: GRANDES AVENTURAS
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 22
    margin-right: 24
    size: 195 52
    text-align: center
    text-wrap: true
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 10

  EclipsePanel
    id: loginFrame
    size: 291 360
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    margin-top: 60
    phantom: true

  EclipseLabel
    id: loginTitle
    text: FAÇA SEU LOGIN
    anchors.top: loginFrame.top
    anchors.horizontalCenter: loginFrame.horizontalCenter
    margin-top: 32
    size: 240 22
    ttf-font: /fonts/ttf/Cinzel-Regular.ttf
    ttf-font-size: 18
    text-align: center

  EclipseLabel
    id: emailLabel
    text: E-mail
    visible: false

  EclipseLabel
    id: passwordLabel
    text: Senha
    visible: false

  EclipseInput
    id: accountNameTextEdit
    placeholder: Seu e-mail
    anchors.left: loginFrame.left
    anchors.right: loginFrame.right
    anchors.top: loginFrame.top
    margin-left: 30
    margin-right: 30
    margin-top: 65

  UIWidget
    image-source: /images/eclipse-login/account
    size: 15 18
    anchors.left: accountNameTextEdit.left
    anchors.verticalCenter: accountNameTextEdit.verticalCenter
    margin-left: 9
    phantom: true

  EclipseInput
    id: accountPasswordTextEdit
    placeholder: Senha
    text-hidden: true
    anchors.left: accountNameTextEdit.left
    anchors.right: accountNameTextEdit.right
    anchors.top: accountNameTextEdit.bottom
    margin-top: 9

  UIWidget
    image-source: /images/eclipse-login/password
    size: 15 20
    anchors.left: accountPasswordTextEdit.left
    anchors.verticalCenter: accountPasswordTextEdit.verticalCenter
    margin-left: 9
    phantom: true

  EclipseCheckBox
    id: rememberEmailBox
    text: Lembrar de mim
    anchors.left: accountNameTextEdit.left
    anchors.top: accountPasswordTextEdit.bottom
    margin-top: 10
    width: 125
    tooltip: Salva seu e-mail neste computador.
    @onCheckChange: EclipseLogin.updatePasswordOption()

  UIButton
    id: Forgot_password_email
    text: Esqueceu sua senha?
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 10
    color: #a375d8
    size: 114 16
    anchors.right: accountPasswordTextEdit.right
    anchors.top: rememberEmailBox.top
    @onClick: EclipseLogin.openLink('recoverAccount')
    $hover:
      color: #d6b1ff

  EclipseCheckBox
    id: rememberPasswordBox
    text: Salvar senha
    visible: false
    anchors.left: rememberEmailBox.left
    anchors.top: rememberEmailBox.bottom
    margin-top: 3
    width: 125
    tooltip: Opcional. Salva a senha usando a proteção existente do client. Evite em computadores compartilhados.
    @onCheckChange: EclipseLogin.updatePasswordOption()

  EclipseButton
    id: loginButton
    text: ENTRAR
    ttf-font: /fonts/ttf/Cinzel-Regular.ttf
    ttf-font-size: 18
    image-source: /images/eclipse-login/button-primary
    height: 42
    anchors.left: accountNameTextEdit.left
    anchors.right: accountNameTextEdit.right
    anchors.top: rememberEmailBox.bottom
    margin-top: 23
    @onClick: EnterGame.doLogin()

  UIWidget
    anchors.left: loginButton.left
    anchors.right: loginButton.right
    anchors.top: loginButton.bottom
    margin-top: 20
    height: 1
    background-color: #7b633670
    phantom: true

  EclipseButton
    id: btnCreateNewAccount
    text: CRIAR CONTA
    ttf-font: /fonts/ttf/Cinzel-Regular.ttf
    ttf-font-size: 13
    anchors.left: loginButton.left
    anchors.right: loginButton.right
    anchors.top: loginButton.bottom
    margin-top: 42
    @onClick: EclipseLogin.createAccount()

  EclipseButton
    id: discordButton
    size: 26 26
    image-source: /images/eclipse-login/discord
    anchors.top: btnCreateNewAccount.bottom
    anchors.horizontalCenter: loginFrame.horizontalCenter
    margin-top: 13
    margin-left: -36
    tooltip: Discord
    @onClick: EclipseLogin.openLink('discord')

  EclipseButton
    id: youtubeButton
    size: 26 26
    image-source: /images/eclipse-login/youtube
    anchors.top: discordButton.top
    anchors.horizontalCenter: loginFrame.horizontalCenter
    margin-left: 36
    tooltip: YouTube
    @onClick: EclipseLogin.openLink('youtube')

  UIWidget
    image-source: /images/eclipse-login/news-welcome
    size: 26 25
    anchors.top: discordButton.top
    anchors.horizontalCenter: loginFrame.horizontalCenter
    margin-top: 2
    phantom: true

  EclipseLabel
    id: serverInfoLabel
    anchors.left: loginButton.left
    anchors.right: loginButton.right
    anchors.top: loginButton.bottom
    margin-top: 6
    height: 14
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 10
    text-align: center
    color: #bda6d4

  EclipsePanel
    id: newsFrame
    size: 263 310
    padding: 20
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 45
    margin-top: -32
    EclipseLabel
      id: newsHeading
      text: ÚLTIMAS NOTÍCIAS
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      ttf-font: /fonts/ttf/Cinzel-Regular.ttf
      ttf-font-size: 17
      color: #cca0e7
    EclipseNewsItem
      id: news1
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: newsHeading.bottom
      margin-top: 8
    EclipseNewsItem
      id: news2
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: news1.bottom
      margin-top: 6
    EclipseNewsItem
      id: news3
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: news2.bottom
      margin-top: 6
    EclipseButton
      id: allNewsButton
      text: VER TODAS AS NOTÍCIAS
      ttf-font: /fonts/ttf/Cinzel-Regular.ttf
      ttf-font-size: 11
      height: 24
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      @onClick: EclipseLogin.showNews()

  EclipsePanel
    id: actionsFrame
    size: 158 236
    padding: 12
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 24
    margin-top: 95
    EclipseNavButton
      id: statusButton
      text: STATUS
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      @onClick: EclipseLogin.showStatus()
    EclipseNavButton
      id: optionsButton
      text: OPÇÕES
      anchors.top: statusButton.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7
      @onClick: modules.client_options.show()
    EclipseNavButton
      id: cinematicsButton
      text: CINEMÁTICAS
      anchors.top: optionsButton.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7
      @onClick: EclipseLogin.openLink('cinematics')
    EclipseNavButton
      id: websiteButton
      text: WEBSITE
      anchors.top: cinematicsButton.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7
      @onClick: EclipseLogin.openLink('website')
    EclipseNavButton
      id: exitButton
      text: SAIR
      anchors.top: websiteButton.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7
      @onClick: g_app.exit()

  EclipseLabel
    id: eclipseBrand
    text: ECLIPSE
    color: #c08de7
    ttf-font: /fonts/ttf/Cinzel-Regular.ttf
    ttf-font-size: 23
    size: 250 22
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 24
    margin-bottom: 31
  EclipseLabel
    id: eclipseTagline
    text: UM MUNDO EM CONSTANTE EVOLUÇÃO
    color: #a991b9
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 9
    size: 260 16
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 24
    margin-bottom: 15
  EclipseLabel
    id: onlinePlayersLabel
    text: Jogadores online: não informado
    ttf-font: /fonts/ttf/Verdana.ttf
    ttf-font-size: 10
    size: 240 18
    text-align: right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 24
    margin-bottom: 15
