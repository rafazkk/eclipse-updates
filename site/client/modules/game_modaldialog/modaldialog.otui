ModalDialogMessageLabel < UILabel
  font: $var-cip-font-new
  color: #dac7a2
  text-align: left
  text-wrap: true

ChoiceListLabel < Label
  height: 16
  font: $var-cip-font-new
  color: #dac7a2
  text-offset: 1 0
  focusable: true

ChoiceListLabelOdd < ChoiceListLabel
  background-color: #100a1d

  $focus:
    background-color: #100a1d
    color: #f1e6d0

  $!focus:
    background-color: #100a1d
    color: #dac7a2

ChoiceListLabelEven < ChoiceListLabel
  background-color: #100a1d

  $focus:
    background-color: #100a1d
    color: #f1e6d0

  $!focus:
    background-color: #100a1d
    color: #dac7a2

ChoiceList < TextList
  id: choiceList
  vertical-scrollbar: choiceScrollBar
  anchors.top: prev.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  margin-top: 5
  margin-bottom: 16
  image-source: /images/ui/1pixel-down-frame
  image-border: 3
  border-width: 0
  background-color: #100a1d
  padding: 1
  auto-focus: none
  focusable: false
  visible: false

ChoiceScrollBar < VerticalQtScrollBar
  id: choiceScrollBar
  anchors.top: choiceList.top
  anchors.bottom: choiceList.bottom
  anchors.right: choiceList.right
  margin-top: 1
  margin-bottom: 1
  margin-right: 1
  step: 16
  pixels-scroll: true
  visible: false

ModalButton < CipsoftButton
  size: 43 20
  fixed-size: true
  color: #f1e6d0
  text-offset: 0 0

ModalDialog < MainWindowHigh
  id: modalDialog
  font: $var-cip-font-new
  color: #dac7a2
  text-offset: 0 2
  size: 245 100
  padding-top: 30
  padding-left: 16
  padding-right: 16
  padding-bottom: 16
  &minimumWidth: 200
  &maximumWidth: 245
  &minimumChoices: 3
  &maximumChoices: 10

  ModalDialogMessageLabel
    id: messageLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: -1
    margin-right: -5

  ChoiceList

  HorizontalSeparatorFlat
    id: choiceSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 11

  Panel
    id: buttonsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 20
    layout: horizontalBox
      align-right: true

  ChoiceScrollBar
